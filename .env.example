# DenDenMushi k6 environment.
# Copy to .env only for local use. Do not commit real cookies, tokens, or IDs.

# AWS dev is the default target.
BASE_URL=https://api.ddm.keiyam.me

# Required for authenticated routes. Paste only the Cookie header value from an
# active ALB-authenticated browser session, or keep the "Cookie:" prefix.
DDM_ALB_COOKIE_HEADER='Cookie: AWSELBAuthSessionCookie-0=example; AWSELBAuthSessionCookie-1=example'

# Required for SSH session lifecycle tests.
HOST_ID=host-123
CR_ID=cr-123

# Optional scenario tuning.
K6_VUS=5
K6_DURATION=2m
K6_RAMP_UP=30s
K6_RAMP_DOWN=30s
K6_SESSION_HOLD_SECONDS=2
K6_WS_COMMAND='printf ddm-k6\n'

# Optional local evidence capture for make *-report targets.
K6_CAPTURE_VIDEO=0
K6_VIDEO_SECONDS=180
